# A T-Deck whose console is the Grove connector rather than USB.
#
# GPIO43 and GPIO44 are the S3's U0TXD and U0RXD, and LilyGo brings them
# out on Grove (their headers name the pair BOARD_GPS_TX_PIN and
# BOARD_GPS_RX_PIN). A TTL cable there talks to the machine while it
# runs on its battery, which the USB console cannot: unplugging the
# cable is the condition being measured.
#
# USB stays as a secondary console, which IDF makes output-only, so a
# board on USB still prints. Input comes from the wire.
#
# Not the default, and unverified on real hardware: a T-Deck Plus wires
# the GPS to those two pins, so this build would talk into the receiver
# and read NMEA back. Plain T-Decks only.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
