# The net stack is a thin binding over the firmware's own EFI_TCP4 and
# EFI_UDP4 (src/net.c), so the net tests need firmware built with
# edk2's NetworkPkg. OVMF and ArmVirtQemu ship with it; the RiscVVirt
# blob qemu ships does not -- it publishes the virtio-net
# SimpleNetworkProtocol and nothing above it, no mnp/arp/ip4/dhcp4/
# tcp4/udp4 (measured; see docs/uefi-notes.md).
#
# So this describes the *firmware*, not the arch, and is an option
# rather than a constant precisely because you can build your own with
# NETWORK_ENABLE and point OVMF_CODE at it. Its default is per-arch.
option('fw_network', type: 'feature', value: 'auto',
  description: 'firmware provides EFI_TCP4/EFI_UDP4 (enables the net tests)')

# efi: firmware boot, any of x86_64/aarch64/riscv64.
# microvm: qemu's firmware-less x86_64 machine type -- own PVH entry,
# paging, idt and lapic, with virtio-mmio for 9p and rng. Its root
# filesystem is a host directory over virtio-9p. No network stack.
# x86_64-only.
#
# A build is configured for one platform or the other, and `meson test`
# runs whichever suite that build can produce a guest for.
# hosted: lua-os as a linux process. The host directory named with -r is
# the root, served by the same task/espsrv.lua the other machines use,
# and the terminal is the console. It links the host's libc rather than
# src/libc, has no devices, and exists to run the tree without an image
# or an emulator in the way.
option('platform', type: 'combo', choices: ['efi', 'microvm', 'hosted'],
  value: 'efi',
  description: 'efi (firmware boot, all arches), microvm (bare PVH, x86_64) or hosted (a linux process)')

# What the microvm image runs when fw_cfg injects nothing.
#
# On qemu the payload is a host file handed over through fw_cfg, which
# is how every boot test starts code. OpenBSD vmd cannot do that: its
# fw_cfg serves a fixed list and will not take a file, so the embedded
# fallback is the ONLY thing that can ever run there. Leaving it hard
# coded meant vmd could boot exactly one program -- the console repl --
# and so could never run a test.
#
# Pointing this at a test payload builds an image that runs it on vmd
# with nothing injected and nothing typed.
# init.lua is the same payload the other machines run, so a microvm
# assembles its namespace and starts /etc/services.lua like anything
# else. boot/microvm.lua is still here and still the right answer for
# bringing up a loader that has never booted this: it asks for nothing
# but the console, where init asks for what the machine says it has.
option('boot_payload', type: 'string', value: 'init.lua',
  description: 'lua payload embedded in the microvm image as the fw_cfg fallback')

# -fsanitize=undefined, trapping rather than reporting.
#
# Off by default, and the reason is measurement rather than taste: the
# cost lands on the serializer's byte loops, where a check fires per
# iteration. Measured on test/bench_ipc.lua, cycles per message:
#
#	1 B        1305 -> 1358    1.04x
#	64 B       1756 -> 2102    1.20x
#	4 KB      28372 -> 43142   1.52x
#	60 KB    230581 -> 442389  1.92x
#
# Bulk IPC bandwidth halves, 1117 MB/s to 582. Anything measured on a
# build with this on is measuring this, so benchmarks want it off and
# bug hunts want it on.
#
# Trap mode needs no runtime, which is what makes it usable at all in a
# -ffreestanding -nostdinc kernel with no libc to link one from. The
# cost of that is a trap says nothing: no line, no reason, just a dead
# machine. Under the boot harness the serial log names the last thing
# that ran, which is usually enough; if it stops being enough, the fix
# is our own __ubsan_handle_* reporting through kernel_log rather than
# a runtime.
#
# lua/ is deliberately NOT instrumented -- hardening_args goes on our
# own targets, not on the vendored interpreter -- so the hot path stays
# as it was and this measures our C.
option('ubsan', type: 'boolean', value: false,
  description: 'trap on undefined behaviour in the kernel C (not lua/)')

# BlueZ's virtual controller, which the HCI tests exchange packets with.
# It is a noinst program -- built only with ./configure --enable-testing
# -- so it is rarely on PATH and usually has to be named outright.
option('btvirt', type: 'string', value: 'btvirt',
  description: 'path to bluez emulator/btvirt, for the ble tests')

# esp32 is built by ESP-IDF's own cmake, which owns the toolchain, the
# Kconfig that every component compiles against, and the closed wifi
# libraries. Pointing at one adds targets that drive it, so a board is
# built and flashed from this build directory rather than by hand:
#
#     ninja -C build esp32-tdeck
#     ninja -C build esp32-tdeck-flash
#
# Empty means the targets do not exist and nothing else changes.
option('esp32_idf', type: 'string', value: '',
  description: 'path to esp-idf; adds the esp32-<board> targets')

option('esp32_port', type: 'string', value: '',
  description: 'default port for esp32-<board>-flash; ESPPORT overrides it')

# The hosted platform's display: an SDL window carrying the framebuffer,
# the keyboard and the pointer. Optional, and auto by default -- a host
# without SDL builds a machine with no screen, which is what --headless
# asks for anyway.
option('sdl', type: 'feature', value: 'auto',
  description: 'hosted: a framebuffer window through SDL3')
