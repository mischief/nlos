build*/
luaos.img

# build output, never source
*.efi

# editor scratch
*.swp
*.swo

# the host-driven tests import test/qemuarch.py
__pycache__/

# ovmf writes its nvram varstore next to the image when qemu runs
OVMF_VARS.fd

# agent worktrees and session state
.claude/

# idf.py generates these next to the project: the merged config it is
# actually building with, and its backup. The inputs are
# sdkconfig.defaults and the per-board overlays beside it.
esp32/sdkconfig
esp32/sdkconfig.old
esp32/*.sdkconfig
